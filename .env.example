ANGELONE_CLIENT_PUBLIC_IP=YOUR_PUBLIC_IPV4
# paper | supervised (proposal-only; never submits orders)
ANGELONE_TRADING_MODE=paper
ANGELONE_PLACE_ORDER=false
ANGELONE_EXCHANGE=NSE
ANGELONE_SYMBOL=RELIANCE
ANGELONE_SYMBOL_TOKEN=YOUR_SYMBOL_TOKEN
# Fill these from verified Angel One instrument details before running --live-readiness.
ANGELONE_INSTRUMENT_TYPE=
ANGELONE_PRODUCT_TYPE=
ANGELONE_TICK_SIZE=
ANGELONE_ORDER_TYPE=
ANGELONE_ORDER_VALIDITY=
ANGELONE_ORDER_QUANTITY=1
ANGELONE_LOT_SIZE=1
ANGELONE_MAX_RISK=0
ANGELONE_MAX_DAILY_TRADES=3
ANGELONE_SESSION_START=09:15
ANGELONE_SESSION_END=15:30
REPORT_TO_EMAIL=YOUR_EMAIL_ADDRESS
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=YOUR_EMAIL_ADDRESS
